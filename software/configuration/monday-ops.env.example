# Public operations configuration template.
# Replace both CHANGE_ME values before running monday_ops.sh.

# MAC address of the local QCA7000/Devolo Green PHY adapter.
DEVOLO_MAC=CHANGE_ME

# SHA-256 of the deployed evse-monday.ini file.
# Generate with: sha256sum /path/to/evse-monday.ini
MONDAY_PROFILE_SHA256=CHANGE_ME
